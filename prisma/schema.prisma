// Prisma schema. The connection URL lives in prisma.config.ts.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum UserRole {
  USER
  ADMIN
}

// Tables
model User {
  id        String   @id @default(uuid())
  fullName  String  @db.VarChar(100)
  email     String  @unique @db.VarChar(100)
  passwordHash String  @db.Text
  role      UserRole @default(USER)

  refreshToken String? @db.Text  // Legacy field - kept for backward compatibility
  isActive  Boolean  @default(true) // for soft delete

  // Relations
  refreshTokens RefreshToken[]

  // add fields as required

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  // SHA-256 of the opaque token. The raw token only ever lives in the client cookie.
  tokenHash String   @unique @db.VarChar(64)
  // All tokens issued from one login share a family; replaying a revoked
  // token revokes the whole family.
  familyId  String   @db.Uuid
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceInfo String? @db.VarChar(255) // Browser/device identifier
  ipAddress  String? @db.VarChar(45)  // IPv4 or IPv6

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}
