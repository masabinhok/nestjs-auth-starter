// Prisma schema. The connection URL lives in prisma.config.ts.
//
// Tables backing @nestjs/authentication's storage contracts are marked
// "contract". Their rules (single conditional writes, atomic consumes) are
// implemented in src/auth/stores/prisma-authentication.store.ts and checked
// by the package's contract suite in test/stores.e2e-spec.ts.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id              String    @id @default(uuid())
  fullName        String    @db.VarChar(100)
  /// Stored trimmed and lowercased.
  email           String    @unique @db.VarChar(254)
  emailVerifiedAt DateTime?
  /// scrypt (`$scrypt$…`), or bcrypt (`$2b$…`) for accounts created by v1
  /// that have not signed in since. Null for passwordless accounts.
  passwordHash    String?   @db.Text
  role            UserRole  @default(USER)
  isActive        Boolean   @default(true)

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions       Session[]
  refreshTokens  RefreshToken[]
  totp           TotpCredential?
  recoveryCodes  RecoveryCode[]
  oauthAccounts  OAuthAccount[]
  apiKeys        ApiKey[]
  passkeys       Passkey[]
  emailTokens    EmailToken[]
  authEvents     AuthEvent[]

  @@map("users")
}

/// contract: sessions. `id` is the SHA-256 of the cookie token.
model Session {
  id           String   @id @db.VarChar(64)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime
  expiresAt    DateTime
  lastActiveAt DateTime
  /// "pending" | "verified"
  mfa          String?  @db.VarChar(16)
  metadata     Json?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// contract: refreshTokens. `id` is the SHA-256 of the opaque token.
model RefreshToken {
  id              String    @id @db.VarChar(64)
  familyId        String    @db.VarChar(64)
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime
  expiresAt       DateTime
  familyExpiresAt DateTime
  usedAt          DateTime?
  claims          Json?

  @@index([userId])
  @@index([familyId])
  @@index([familyExpiresAt])
  @@map("refresh_tokens")
}

/// contract: refreshTokens. A revoked family stays revoked for tokens saved later.
model RefreshTokenFamilyRevocation {
  familyId  String   @id @db.VarChar(64)
  revokedAt DateTime @default(now())

  @@map("refresh_token_family_revocations")
}

/// contract: mfa.
model TotpCredential {
  userId        String  @id
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret        String  @db.Text
  confirmed     Boolean @default(false)
  pendingSecret String? @db.Text
  lastUsedStep  BigInt?

  @@map("totp_credentials")
}

/// contract: mfa.
model RecoveryCode {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  hash   String @db.VarChar(255)

  @@id([userId, hash])
  @@map("recovery_codes")
}

/// contract: mfa. One row per failed code, counted inside the lockout window.
model MfaFailure {
  id     BigInt   @id @default(autoincrement())
  userId String
  at     DateTime

  @@index([userId, at])
  @@map("mfa_failures")
}

/// contract: emailTokens. `id` is the SHA-256 of the mailed token.
model EmailToken {
  id          String   @id @db.VarChar(64)
  /// "password-reset" | "email-verification"
  purpose     String   @db.VarChar(32)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email       String   @db.VarChar(254)
  fingerprint String?  @db.VarChar(64)
  createdAt   DateTime
  expiresAt   DateTime

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("email_tokens")
}

/// contract: magicLinks.
model MagicLink {
  id         String   @id @db.VarChar(64)
  email      String   @db.VarChar(254)
  createdAt  DateTime
  expiresAt  DateTime
  redirectTo String?  @db.Text

  @@index([expiresAt])
  @@map("magic_links")
}

/// contract: oidcStates. Logins in progress, keyed by `state`.
model OidcState {
  state         String   @id @db.VarChar(128)
  provider      String   @db.VarChar(64)
  nonce         String?  @db.VarChar(255)
  codeVerifier  String   @db.VarChar(255)
  redirectTo    String?  @db.Text
  createdAt     DateTime
  expiresAt     DateTime
  linkUserId    String?
  linkSessionId String?  @db.VarChar(64)

  @@index([expiresAt])
  @@map("oidc_states")
}

/// External identities (Google, GitHub), linked by (provider, subject).
model OAuthAccount {
  id        String   @id @default(uuid())
  provider  String   @db.VarChar(64)
  subject   String   @db.VarChar(255)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String?  @db.VarChar(254)
  createdAt DateTime @default(now())

  @@unique([provider, subject])
  @@index([userId])
  @@map("oauth_accounts")
}

/// API keys: `<prefix>_<id>_<secret>`. Only the public id and a SHA-256 of
/// the whole key are stored.
model ApiKey {
  id         String    @id @db.VarChar(64)
  hash       String    @db.VarChar(64)
  name       String    @db.VarChar(100)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([userId])
  @@map("api_keys")
}

/// WebAuthn credentials. `id` is the base64url credential id.
model Passkey {
  id           String    @id @db.VarChar(512)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String    @db.VarChar(100)
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String[]
  deviceType   String    @db.VarChar(32)
  backedUp     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
  @@map("passkeys")
}

/// Pending WebAuthn ceremonies. Consumed once, atomically.
model WebauthnChallenge {
  id        String   @id @db.VarChar(64)
  challenge String   @db.VarChar(255)
  /// "registration" | "authentication"
  purpose   String   @db.VarChar(16)
  userId    String?
  expiresAt DateTime

  @@index([expiresAt])
  @@map("webauthn_challenges")
}

/// Audit trail: sign-ins, failures, lockouts, MFA and key changes.
model AuthEvent {
  id        BigInt   @id @default(autoincrement())
  type      String   @db.VarChar(64)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress String?  @db.VarChar(45)
  data      Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("auth_events")
}
