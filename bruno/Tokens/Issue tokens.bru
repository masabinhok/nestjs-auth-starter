meta {
  name: Issue tokens
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/token
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  bru.setVar('accessToken', res.body.accessToken);
  bru.setVar('refreshToken', res.body.refreshToken);
}

docs {
  For mobile apps and CLIs. Add "code" when the user has 2FA.
}
