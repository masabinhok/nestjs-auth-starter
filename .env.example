# Copy to .env. Every variable is validated at startup (src/config/env.ts).
# Generate secrets with: openssl rand -base64 32

# --- App -------------------------------------------------------------------
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
# Public URL of this API (JWT issuer, OAuth callbacks).
APP_URL=http://localhost:8080
# Public URL of your web app: emailed links open its pages
# (/verify-email, /reset-password, /magic-link).
WEB_URL=http://localhost:3000
# Origins allowed to call the API with cookies, comma-separated. No "*".
CORS_ORIGIN=http://localhost:3000
# Set behind a load balancer so rate limits see client IPs, e.g. 1 for one hop.
# TRUST_PROXY=1
API_DOCS=true

# --- Data ------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nest_auth
# Shared rate limits across instances. Optional.
# REDIS_URL=redis://localhost:6379

# --- Auth ------------------------------------------------------------------
AUTH_JWT_SECRET=change-me-to-32-random-bytes-from-openssl
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=30d
AUTH_SESSION_TTL=7d
AUTH_SESSION_IDLE_TTL=1d
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT=15m
# Secure cookies work on http://localhost too; turn off only for plain HTTP elsewhere.
AUTH_COOKIE_SECURE=true
# scrypt cost; 17 is the OWASP minimum. Lower only in tests.
AUTH_SCRYPT_LOG_N=17
AUTH_API_KEY_PREFIX=nak

# Feature toggles. A disabled feature registers no routes.
AUTH_MFA=true
AUTH_MFA_ENCRYPTION_KEY=change-me-to-another-32-random-bytes
AUTH_MAGIC_LINK=true
AUTH_API_KEYS=true
AUTH_PASSKEYS=true
AUTH_PASSKEY_RP_NAME="NestJS Auth Starter"
# Defaults to the hostname of WEB_URL.
# AUTH_PASSKEY_RP_ID=localhost

# Social sign-in: set both values to enable a provider.
# Callback URL to register: ${APP_URL}/api/v1/auth/oidc/<provider>/callback
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_GITHUB_CLIENT_ID=
# AUTH_GITHUB_CLIENT_SECRET=

# --- Mail ------------------------------------------------------------------
# smtp (Mailpit from docker compose: inbox at http://localhost:8025), log, or memory.
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
MAIL_FROM="NestJS Auth Starter <no-reply@example.com>"

# --- Seed (pnpm prisma:seed, development only) -----------------------------
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=
